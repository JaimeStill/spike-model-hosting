{{/*
  The llama.cpp router's model presets, rendered from a host-class profile. Keys are llama-server
  argument names without their leading dashes. Every model runs its GGUF's embedded chat
  template (jinja) and exposes /metrics, so those two are not profile fields. Each model's slots
  render as parallel in its own section, after its c; the router applies [*] and then a model's
  section, so the section's value is the one the model runs at. Setting parallel turns
  kv-unified's auto default off, so a unified KV pool, the host class's for every model, is
  stated explicitly in [*], and a per-slot one is the absence of the key. The startup set's models load when the router starts
  (load-on-startup), so the set's memory is committed up front, not on a model's first request.
  Every other model renders without the key, which the router reads as false (it loads a model
  at startup only when the key is present and truthy), so it stays unloaded until a load
  request over the router's API. Each section names its own weights, hf-repo = its router ID:
  the router passes a section's hf-repo to the model's process, and a section without one gets
  it only by merging with the router's entry for a model already in its Hugging Face cache, so a
  model not yet downloaded would start with no model at all (llama-server then runs as a second
  router). A model's image batch cap renders as mtmd-batch-max-tokens after its c, only when set,
  so the server's default stands otherwise. A model's typed sampling renders as llama.cpp's
  keys; its raw args render after them, in key order, as given.
*/ -}}
; llama.cpp router presets for the {{.HostClass}} host class, rendered from its profile.
; Engine: {{.Engine.Name}} ({{.Engine.Backend}}), build {{.Engine.MinBuild}} or later.

[*]
jinja = true
n-gpu-layers = {{.Defaults.GPULayers}}
c = {{.Defaults.C}}
metrics = true
checkpoint-min-step = {{.Defaults.CheckpointMinStep}}
{{- if eq .KV "unified"}}
kv-unified = true
{{- end}}
{{range .Models}}
; {{.Publisher}} ({{.Origin}}). Card: {{.CardURL}}
; Licence: {{.Licence}}. Roles: {{join .Roles ", "}}.
{{- with .Sampling}}
; Sampling: {{.Source}}
{{- end}}
;
{{comment .CReason -}}
;
{{comment .SlotsReason -}}
{{- if .MtmdBatchMaxTokensReason}};
{{comment .MtmdBatchMaxTokensReason}}{{end -}}
{{- with .Sampling}};
{{comment .Reason}}{{end -}}
{{- if .ArgsReason}};
{{comment .ArgsReason}}{{end -}}
[{{.ID}}]
{{- if index $.Startup .ID}}
load-on-startup = true
{{- end}}
hf-repo = {{.ID}}
c = {{.C}}
parallel = {{.Slots}}
{{- if .MtmdBatchMaxTokens}}
mtmd-batch-max-tokens = {{.MtmdBatchMaxTokens}}
{{- end}}
{{- with .Sampling}}
temp = {{.Temperature}}
top-p = {{.TopP}}
top-k = {{.TopK}}
min-p = {{.MinP}}
{{- if .Reasoning}}
chat-template-kwargs = {"reasoning_effort":"{{.Reasoning}}"}
{{- end}}
{{- end}}
{{- range $key, $value := .Args}}
{{$key}} = {{$value}}
{{- end}}
{{end -}}
