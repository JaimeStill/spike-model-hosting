{{/*
  The llama.cpp router's systemd unit, rendered from a host-class profile and the host values
  given at render time. It mirrors the unit personal-agents documents (setup/hosting-setup.md,
  "Run it as a service"). The engine runs through the build's current link, so moving to
  another build never edits the unit. llama-server runs in router mode (no model on its
  command line), with the presets at their installed path; --no-models-autoload keeps a request
  from loading a model, while load-on-startup in the presets loads each of the profile's models
  when the router starts. The command line carries only what can't differ per model.

  A tailnet bind resolves the host's tailnet IPv4 when the unit starts, through a shell
  wrapper, so no address or name is ever rendered; it needs tailscaled up first. systemd
  leaves $( alone, since it expands only $NAME and ${NAME}. A loopback bind needs no tailnet.
*/ -}}
# The llama.cpp router for the {{.Profile.HostClass}} host class, rendered from its profile.
# Engine: {{.Profile.Engine.Name}} ({{.Profile.Engine.Backend}}), build {{.Profile.Engine.MinBuild}} or later, run through the current link.
[Unit]
Description=llama.cpp router (model server)
{{- if eq .Profile.Bind "tailnet"}}
After=network-online.target tailscaled.service
Wants=network-online.target
Requires=tailscaled.service
{{- else}}
After=network-online.target
Wants=network-online.target
{{- end}}

[Service]
Type=simple
User={{.Host.ServiceUser}}
Environment=HF_HOME={{.Host.HFHome}}
ExecStart=/usr/bin/bash -c 'exec {{.Engine}} --models-dir {{.Host.ModelsDir}} --no-models-autoload --host {{.Address}} --port {{.Port}} --models-preset {{.Presets}}'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
