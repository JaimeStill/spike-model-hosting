{{/*
  The llama.cpp router's model presets, rendered from a host-class profile. Keys are llama-server
  argument names without their leading dashes. Every model runs its GGUF's embedded chat
  template (jinja) and exposes /metrics, so those two are not profile fields. Setting parallel
  turns kv-unified's auto default off, so a unified KV pool is stated explicitly, and a per-slot
  one is the absence of the key. Every model loads when the router starts (load-on-startup), so
  the set's memory is committed up front, not on a model's first request. A model's typed
  sampling renders as llama.cpp's keys; its raw args render after them, in key order, as given.
*/ -}}
; llama.cpp router presets for the {{.HostClass}} host class, rendered from its profile.
; Engine: {{.Engine.Name}} ({{.Engine.Backend}}), build {{.Engine.MinBuild}} or later.

[*]
jinja = true
n-gpu-layers = {{.Defaults.GPULayers}}
c = {{.Defaults.C}}
metrics = true
checkpoint-min-step = {{.Defaults.CheckpointMinStep}}
parallel = {{.Slots}}
{{- if eq .KV "unified"}}
kv-unified = true
{{- end}}
{{range .Models}}
; {{.Publisher}} ({{.Origin}}). Card: {{.CardURL}}
{{- with .Sampling}}
; Sampling: {{.Source}}
{{- end}}
;
{{comment .CReason -}}
{{- with .Sampling}};
{{comment .Reason}}{{end -}}
{{- if .ArgsReason}};
{{comment .ArgsReason}}{{end -}}
[{{.ID}}]
load-on-startup = true
c = {{.C}}
{{- with .Sampling}}
temp = {{.Temperature}}
top-p = {{.TopP}}
top-k = {{.TopK}}
min-p = {{.MinP}}
{{- if .Reasoning}}
chat-template-kwargs = {"reasoning_effort":"{{.Reasoning}}"}
{{- end}}
{{- end}}
{{- range $key, $value := .Args}}
{{$key}} = {{$value}}
{{- end}}
{{end -}}
